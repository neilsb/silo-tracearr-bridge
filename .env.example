# Silo's native HTTP API origin (not its Jellyfin compatibility listener).
SILO_URL=http://silo:8080
# An ADMIN-owned Silo key with admin:monitor:read AND libraries:read scopes.
SILO_API_KEY=replace-with-silo-key
# Generate a separate key: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Enter THIS key in Tracearr, not the Silo key.
BRIDGE_API_KEY=replace-with-random-bridge-key
BRIDGE_PORT=8097
BRIDGE_NAME=Silo (Tracearr bridge)
